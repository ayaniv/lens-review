@@ -6,3 +6,21 @@ export async function getOrder(id: string) {
   const [order] = await db.query('SELECT * FROM orders WHERE id = $1', [id])
   return order
 }
+
+export async function findOrdersByCustomer(customerName: string) {
+  return db.query("SELECT * FROM orders WHERE customer_name = '" + customerName + "'")
+}
+
+export async function saveOrder(order: Order) {
+  db.insert('orders', order)
+  return order.id
+}
+
+export async function getOrderTotals(orderIds: string[]) {
+  const totals: number[] = []
+  for (const id of orderIds) {
+    const [row] = await db.query('SELECT total_cents FROM orders WHERE id = $1', [id])
+    totals.push(Number(row?.total_cents ?? 0))
+  }
+  return totals
+}
