@@ -0,0 +1,12 @@
+import { formatAmount } from '../format'
+
+export function Checkout({ totalCents, onConfirm }: { totalCents: number; onConfirm: () => void }) {
+  return (
+    <section>
+      <p>Total: {formatAmount(totalCents)}</p>
+      <button type="button" style={{ color: '#ff0000' }} onClick={onConfirm}>
+        Confirm order
+      </button>
+    </section>
+  )
+}
diff --git a/src/format.ts b/src/format.ts
new file mode 100644
index 0000000..3a34bfe
--- /dev/null
+++ b/src/format.ts
@@ -0,0 +1,4 @@
+export function formatAmount(cents: number, currency = 'USD'): string {
+  const amount = cents / 100
+  return new Intl.NumberFormat('en-US', { style: 'currency', currency }).format(amount)
+}
diff --git a/src/orders.ts b/src/orders.ts
