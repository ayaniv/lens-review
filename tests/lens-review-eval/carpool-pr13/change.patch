+++ b/e2e/standing-drives.spec.ts
@@ -0,0 +1,165 @@
+import { expect, test, type Page } from '@playwright/test';
+import { adminClient, anonymousDevice, CHILD_C, FIXTURE_AREAS, GROUP_A, readAuthFixtureEnv } from './fixtures/authFixture';
+
+// Standing drives: the team's sheet of who drives which leg every week (e.g. "שם (שם שם שם)" always takes
+// Wednesday's שם) is loaded once, and each new week's cars come already filled with those drivers. A parent can
+// still release one week's car; it is never refilled. Runs only against the local Supabase stack.
+const fixture = readAuthFixtureEnv();
+
+/** Wednesday: any weekday works, the rolling window always holds the next practice of every slot. */
+const WEEKDAY = 3;
+
+/** שם always drives שם in car 1; שם always drives שם in car 2. */
+const FAMILY_A = { name: 'שם', child: 'שם' };
+const FAMILY_B = { name: 'שם', child: 'שם' };
+
+interface StandingGroup {
+  id: string;
+  token: string;
+  slotId: string;
+  familyAId: string;
+  familyAChildId: string;
+  familyBId: string;
+  familyBChildId: string;
+}
+
+/** A group of its own per project, so the cars this spec fills and releases are never another spec's. */
+const GROUP_BY_PROJECT: Record<string, StandingGroup> = {
+  mobile: {
+    id: '00000000-0000-4000-8000-0000000e2e5a',
+    token: 'e2e-standing-token-mobile',
+    slotId: '40000000-0000-4000-8000-0000000e2e5a',
+    familyAId: '21000000-0000-4000-8000-0000000e2e5a',
+    familyAChildId: '31000000-0000-4000-8000-0000000e2e5a',
+    familyBId: '22000000-0000-4000-8000-0000000e2e5a',
+    familyBChildId: '32000000-0000-4000-8000-0000000e2e5a',
+  },
+  desktop: {
+    id: '00000000-0000-4000-8000-0000000e2e5b',
+    token: 'e2e-standing-token-desktop',
+    slotId: '40000000-0000-4000-8000-0000000e2e5b',
+    familyAId: '21000000-0000-4000-8000-0000000e2e5b',
+    familyAChildId: '31000000-0000-4000-8000-0000000e2e5b',
+    familyBId: '22000000-0000-4000-8000-0000000e2e5b',
+    familyBChildId: '32000000-0000-4000-8000-0000000e2e5b',
+  },
+};
+
+function standingGroup(): StandingGroup {
+  const projectName = test.info().project.name;
+  const group = GROUP_BY_PROJECT[projectName];
+  if (!group) throw new Error(`no standing-drives group for project ${projectName}`);
+  return group;
+}
+
+function must<Result extends { error: { message: string } | null }>(step: string, result: Result): Result {
+  if (result.error) throw new Error(`standing-drives setup: ${step}: ${result.error.message}`);
+  return result;
+}
+
+async function enterAs(page: Page, group: StandingGroup, childId: string): Promise<void> {
+  await page.goto(`/join/${group.token}`);
+  await page.locator(`[data-testid="pick-child"][data-child-id="${childId}"]`).click();
+  await expect(page.getByTestId('week-grid')).toBeVisible();
+}
+
+test.describe('standing drives', () => {
+  test.skip(!fixture, 'needs the E2E_SUPABASE_* variables and a local stack with anonymous sign-ins');
+  // The cases share one seeded group per project and release one of its cars: one worker, in order.
+  test.describe.configure({ mode: 'serial' });
+
+  test.beforeAll(async () => {
+    if (!fixture) return;
+    const group = standingGroup();
+    const { slotId } = group;
+    const admin = adminClient(fixture);
+    must('delete group', await admin.from('groups').delete().eq('id', group.id));
+    must('insert group', await admin.from('groups').insert({ id: group.id, name: 'שם שם', invite_token: group.token, areas: FIXTURE_AREAS }));
+    must(
+      'insert schedule',
+      await admin.from('schedule_slots').insert({
+        id: slotId,
+        group_id: group.id,
+        weekday: WEEKDAY,
+        practice_start: '17:00',
+        practice_end: '18:30',
+        pickup_time: '16:30',
+        departure_time: '18:30',
+      }),
+    );
+    must(
+      'insert parents',
+      await admin.from('parents').insert([
+        { id: group.familyAId, group_id: group.id, display_name: FAMILY_A.name, grammatical_gender: 'f' },
+        { id: group.familyBId, group_id: group.id, display_name: FAMILY_B.name, grammatical_gender: 'm' },
+      ]),
+    );
+    must(
+      'insert children',
+      await admin.from('children').insert([
+        { id: group.familyAChildId, group_id: group.id, parent_id: group.familyAId, display_name: FAMILY_A.child, area: FIXTURE_AREAS[0] },
+        { id: group.familyBChildId, group_id: group.id, parent_id: group.familyBId, display_name: FAMILY_B.child, area: FIXTURE_AREAS[1] },
+      ]),
+    );
+    must(
+      'insert standing drives',
+      await admin.from('standing_drives').insert([
+        { group_id: group.id, parent_id: group.familyAId, schedule_slot_id: slotId, direction: 'to', position: 0 },
+        { group_id: group.id, parent_id: group.familyBId, schedule_slot_id: slotId, direction: 'back', position: 1 },
+      ]),
+    );
+  });
+
+  test('a family with a standing drive finds this week’s car already theirs, and only that one', async ({ page }) => {
+    const group = standingGroup();
+    await enterAs(page, group, group.familyAChildId);
+    await expect(page.locator('[data-state="meDriving"]')).toHaveCount(1);
+    // שם's standing שם shows as his, not as an empty slot.
+    await expect(page.locator('[data-state="otherDriver"]')).toHaveCount(1);
+  });
+
+  test('the other family sees the same week from their side', async ({ page }) => {
+    const group = standingGroup();
+    await enterAs(page, group, group.familyBChildId);
+    await expect(page.locator('[data-state="meDriving"]')).toHaveCount(1);
+    await expect(page.locator('[data-state="otherDriver"]')).toHaveCount(1);
+  });
+
+  test('releasing one week’s standing car leaves it open; it is not filled again', async ({ page }) => {
+    if (!fixture) return;
+    const group = standingGroup();
+    await enterAs(page, group, group.familyAChildId);
+    const mine = page.locator('[data-state="meDriving"]');
+    await expect(mine).toHaveCount(1);
+    const carId = (await mine.getAttribute('data-testid'))?.replace(/^slot-/, '');
+    if (!carId) throw new Error('my car has no test id');
+
+    const familyAPhone = await anonymousDevice(fixture);
+    must('claim', await familyAPhone.rpc('claim_child', { p_token: group.token, p_child_id: group.familyAChildId }));
+    const released = await familyAPhone.rpc('release_car', { p_car_id: carId });
+    expect(released.data).toBe('ok');
+
+    // Not a reload: after the pick the page sits on `/`, which here opens group A's picker (the site token), and
+    // re-opening this group's own link reads the week afresh for a device already in it.
+    await page.goto(`/join/${group.token}`);
+    await expect(page.getByTestId('week-grid')).toBeVisible();
+    await expect(page.getByTestId(`slot-${carId}`)).toHaveAttribute('data-state', 'open');
+    await expect(page.locator('[data-state="meDriving"]')).toHaveCount(0);
+  });
+
+  test('standing drives are read only inside their own group and never written by a device', async () => {
+    if (!fixture) return;
+    const group = standingGroup();
+    const outsider = await anonymousDevice(fixture);
+    must('claim', await outsider.rpc('claim_child', { p_token: GROUP_A.token, p_child_id: CHILD_C.id }));
+    expect((await outsider.from('standing_drives').select('parent_id').eq('group_id', group.id)).data ?? []).toEqual([]);
+
+    const member = await anonymousDevice(fixture);
+    must('claim', await member.rpc('claim_child', { p_token: group.token, p_child_id: group.familyBChildId }));
+    expect(((await member.from('standing_drives').select('parent_id')).data ?? []).length).toBe(2);
+    const forged = await member
+      .from('standing_drives')
+      .insert({ group_id: group.id, parent_id: group.familyBId, schedule_slot_id: group.slotId, direction: 'to', position: 1 });
+    expect(forged.error).not.toBeNull();
+  });
+});
