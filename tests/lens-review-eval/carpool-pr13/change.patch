@@ -0,0 +1,99 @@
+// @vitest-environment node
+// supabase/families-seed.template.sql is what the developer fills with the team's families and standing drives and
+// pastes into the hosted SQL editor after the production seed (README "Upgrading an existing deploy"); this proves it
+// applies to the migrated schema as written, on top of that seed.
+import { readFileSync } from 'node:fs';
+import { resolve } from 'node:path';
+import type { PGlite } from '@electric-sql/pglite';
+import { afterAll, beforeAll, beforeEach, describe, expect, it } from 'vitest';
+import { BOOT_TIMEOUT_MS, bootMigratedDatabase } from './testing/migratedDatabase';
+
+const PRODUCTION_SEED = readFileSync(resolve(process.cwd(), 'supabase/production-seed.template.sql'), 'utf8');
+const FAMILIES_SEED = readFileSync(resolve(process.cwd(), 'supabase/families-seed.template.sql'), 'utf8');
+
+/** The template's first placeholder family, as written in it. */
+const FIRST_CHILD = 'שם/שם 1';
+const FIRST_AREA = `'${FIRST_CHILD}', 'שם'`;
+const DEVICE = '10000000-0000-4000-8000-0000000000f1';
+
+let database: PGlite;
+
+beforeAll(async () => {
+  database = await bootMigratedDatabase();
+}, BOOT_TIMEOUT_MS);
+
+beforeEach(async () => {
+  await database.exec(`delete from public.groups; delete from auth.users;`); // cascades to every seeded row
+  await database.exec(PRODUCTION_SEED);
+});
+
+afterAll(async () => {
+  await database.close();
+});
+
+async function rows<Row>(sql: string): Promise<Row[]> {
+  return (await database.query<Row>(sql)).rows;
+}
+
+/** Opens the app as the family of `childName`, the way claim_child binds a phone. */
+async function enterAs(childName: string): Promise<void> {
+  await database.query(`insert into auth.users (id) values ($1)`, [DEVICE]);
+  await database.query(
+    `insert into public.parent_devices (user_id, parent_id, group_id)
+     select $1, parent_id, group_id from public.children where display_name = $2`,
+    [DEVICE, childName],
+  );
+  await database.query(`select set_config('request.jwt.claim.sub', $1, false)`, [DEVICE]);
+}
+
+describe('families seed template', () => {
+  it('adds every family, each with its child and an area of the group', async () => {
+    await database.exec(FAMILIES_SEED);
+
+    const families = await rows<{ family: string; child: string; area: string; is_group_area: boolean }>(
+      `select p.display_name as family, c.display_name as child, c.area, c.area = any (g.areas) as is_group_area
+         from public.children c join public.parents p on p.id = c.parent_id join public.groups g on g.id = c.group_id`,
+    );
+    expect(families.length).toBeGreaterThan(1);
+    expect(families.every((family) => family.is_group_area)).toBe(true);
+    expect(new Set(families.map((family) => family.family)).size).toBe(families.length);
+  });
+
+  it('loads the standing drives, so the next weeks’ cars come already filled', async () => {
+    await database.exec(FAMILIES_SEED);
+    const standing = await rows<{ count: number }>(`select count(*)::int as count from public.standing_drives`);
+    expect(standing[0]?.count).toBeGreaterThan(0);
+
+    await enterAs(FIRST_CHILD);
+    await database.query(`select public.ensure_practices('2026-10-25')`);
+    // Every standing drive lands in each of the two weeks' practices of its slot.
+    const filled = await rows<{ count: number }>(`select count(*)::int as count from public.cars where driver_id is not null`);
+    expect(filled[0]?.count).toBe((standing[0]?.count ?? 0) * 2);
+  });
+
+  it('runs again without adding a second family or a second drive', async () => {
+    await database.exec(FAMILIES_SEED);
+    const before = await rows(`select id from public.parents union all select id from public.children`);
+    await database.exec(FAMILIES_SEED);
+    const after = await rows(`select id from public.parents union all select id from public.children`);
+    expect(after).toEqual(before);
+  });
+
+  it('refuses a child whose area the group does not have, and adds no one', async () => {
+    await expect(database.exec(FAMILIES_SEED.replace(FIRST_AREA, `'${FIRST_CHILD}', 'שם שם שם'`))).rejects.toThrow(
+      /not one of the group's areas/,
+    );
+    expect(await rows(`select 1 from public.parents`)).toHaveLength(0);
+  });
+
+  it('refuses a drive for a child it has no family for', async () => {
+    const unknownChild = FAMILIES_SEED.replace(/\('שם\/שם 1', (\d)/, `('שם/שם שם שם', $1`);
+    expect(unknownChild).not.toBe(FAMILIES_SEED);
+    await expect(database.exec(unknownChild)).rejects.toThrow(/no family for child/);
+  });
+
+  it('refuses to run before the production seed created the group', async () => {
+    await database.exec(`delete from public.groups`);
+    await expect(database.exec(FAMILIES_SEED)).rejects.toThrow(/exactly one group/);
+  });
+});
