diff --git a/supabase/families-seed.template.sql b/supabase/families-seed.template.sql
new file mode 100644
index 0000000..151ba12
--- /dev/null
+++ b/supabase/families-seed.template.sql
@@ -0,0 +1,66 @@
+-- The team's families and their standing weekly drives, for the HOSTED project only, run after
+-- production-seed.template.sql. Replace the placeholder rows marked EDIT in the Supabase SQL editor (never commit
+-- real names here) and run it. Safe to run again: a child already in the group (by name, e.g. one whose parent
+-- joined through the link) keeps their family, and a standing drive already loaded is replaced by its row here.
+-- Not wired into config.toml's [db.seed], so `supabase db reset` and `db push` never run it.
+do $$
+declare
+  v_group_id uuid;
+  v_areas text[];
+  v_family record;
+  v_drive record;
+  v_parent_id uuid;
+  v_slot_id uuid;
+begin
+  if (select count(*) from public.groups) <> 1 then
+    raise exception 'expected exactly one group: run production-seed.template.sql first';
+  end if;
+  select id, areas into v_group_id, v_areas from public.groups;
+
+  -- EDIT: one row per family. Both parents of a child share this one family; its name is what the app shows for
+  -- them. The area must be one of the group's areas.
+  for v_family in
+    select * from (values
+      ('שם 1', 'שם/שם 1', 'שם'),
+      ('שם 2', 'שם/שם 2', 'שם'),
+      ('שם 3', 'שם/שם 3', 'שם')
+    ) as f (family_name, child_name, area)
+  loop
+    if v_family.area is null or not v_family.area = any (v_areas) then
+      raise exception 'area % of child % is not one of the group''s areas %', v_family.area, v_family.child_name, v_areas;
+    end if;
+    if not exists (select 1 from public.children where group_id = v_group_id and display_name = v_family.child_name) then
+      insert into public.parents (group_id, display_name)
+      values (v_group_id, v_family.family_name)
+      returning id into v_parent_id;
+      insert into public.children (group_id, parent_id, display_name, area)
+      values (v_group_id, v_parent_id, v_family.child_name, v_family.area);
+    end if;
+  end loop;
+
+  -- EDIT: one row per standing drive, as on the team's sheet. weekday 0 = Sunday; direction 'to' is שם and
+  -- 'back' is שם; car is the sheet's שם 1 or שם 2.
+  for v_drive in
+    select * from (values
+      ('שם/שם 1', 1, 'to', 1),
+      ('שם/שם 2', 1, 'back', 1),
+      ('שם/שם 3', 2, 'to', 2),
+      ('שם/שם 1', 4, 'back', 2)
+    ) as d (child_name, weekday, direction, car)
+  loop
+    select parent_id into v_parent_id from public.children where group_id = v_group_id and display_name = v_drive.child_name;
+    if v_parent_id is null then
+      raise exception 'no family for child % (add them to the families above)', v_drive.child_name;
+    end if;
+    select id into v_slot_id from public.schedule_slots where group_id = v_group_id and weekday = v_drive.weekday;
+    if v_slot_id is null then
+      raise exception 'no practice on weekday % (add it to schedule_slots first)', v_drive.weekday;
+    end if;
+    insert into public.standing_drives (group_id, parent_id, schedule_slot_id, direction, position)
+    values (v_group_id, v_parent_id, v_slot_id, v_drive.direction::public.direction, v_drive.car - 1)
+    on conflict (schedule_slot_id, direction, position) do update set parent_id = excluded.parent_id;
+  end loop;
+end
+$$;
+
+select p.display_name as family, c.display_name as child, c.area from public.children c join public.parents p on p.id = c.parent_id;
diff --git a/supabase/migrations/20261024000001_standing_drives.sql b/supabase/migrations/20261024000001_standing_drives.sql
new file mode 100644
index 0000000..d67c9ce
--- /dev/null
+++ b/supabase/migrations/20261024000001_standing_drives.sql
@@ -0,0 +1,64 @@
+-- Standing drives: the team's fixed weekly rota (each family drives the same leg every week, up to two cars per
+-- leg). ensure_practices() fills the base cars it creates from it, so each new week arrives already filled.
+--
+-- Only cars ensure_practices() CREATES get a driver (`on conflict do nothing`): nothing already in the database
+-- changes, and a car a family released for one week stays open. A phone never writes the rota; the developer
+-- seeds it in the SQL editor (supabase/families-seed.template.sql).
+--
+-- Additive only: the earlier migrations are applied on hosted and stay untouched. Plain statements only, so
+-- `supabase db push` applies the whole file in one transaction or not at all.
+
+create table public.standing_drives (
+  group_id uuid not null,
+  parent_id uuid not null,
+  schedule_slot_id uuid not null,
+  direction public.direction not null,
+  -- The base car: 0 is the sheet's שם 1, 1 its שם 2.
+  position smallint not null check (position in (0, 1)),
+  primary key (schedule_slot_id, direction, position),
+  -- Mirrors cars_one_car_per_leg_per_driver: a filled week must never hold one family in both cars of a leg.
+  unique (schedule_slot_id, direction, parent_id),
+  foreign key (parent_id, group_id) references public.parents (id, group_id) on delete cascade,
+  foreign key (schedule_slot_id, group_id) references public.schedule_slots (id, group_id) on delete cascade
+);
+
+alter table public.standing_drives enable row level security;
+create policy standing_drives_read on public.standing_drives for select using (group_id = public.current_group_id());
+-- Supabase grants every new table to anon and authenticated directly; TRUNCATE is revoked too because it skips RLS.
+revoke insert, update, delete, truncate on public.standing_drives from anon, authenticated;
+
+-- Same body as init.sql's, except that the base-car insert takes its driver from the rota.
+create or replace function public.ensure_practices(p_from date) returns void
+  language plpgsql security definer set search_path = public
+  as $$
+declare
+  v_group uuid := public.current_group_id();
+begin
+  perform public.require_parent();
+
+  insert into public.practices (group_id, schedule_slot_id, practice_date,
+                                practice_start, practice_end, pickup_time, departure_time)
+  select s.group_id, s.id, g.day_ts::date,
+         s.practice_start, s.practice_end, s.pickup_time, s.departure_time
+    from public.schedule_slots s
+    join generate_series(p_from, p_from + 13, interval '1 day') as g (day_ts)
+      on extract(dow from g.day_ts)::int = s.weekday
+   where s.group_id = v_group
+  on conflict (group_id, practice_date) do nothing;
+
+  insert into public.cars (group_id, practice_id, direction, position, driver_id)
+  select p.group_id, p.id, d.direction, pos.position, sd.parent_id
+    from public.practices p
+   cross join (values ('to'::public.direction), ('back'::public.direction)) as d (direction)
+   cross join (values (0::smallint), (1::smallint)) as pos (position)
+    left join public.standing_drives sd
+      on sd.schedule_slot_id = p.schedule_slot_id and sd.direction = d.direction and sd.position = pos.position
+   where p.group_id = v_group and p.practice_date between p_from and p_from + 13
+  on conflict (practice_id, direction, position) do nothing;
+end $$;
+
+-- `create or replace` keeps init.sql's grants (execute for authenticated only); restated so this file stands alone.
+revoke all on function public.ensure_practices(date) from public, anon;
+grant execute on function public.ensure_practices(date) to authenticated;
+
+alter publication supabase_realtime add table public.standing_drives;
