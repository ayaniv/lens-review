+++ b/e2e/names-and-seats.spec.ts
@@ -0,0 +1,184 @@
+import { expect, test, type Locator, type Page } from '@playwright/test';
+import type { SupabaseClient } from '@supabase/supabase-js';
+import { DISPLAY_NAME_MAX_LENGTH } from '../src/auth/authGateway';
+import { anonymousDevice, CHILD_E, FIXTURE_AREAS, GROUP_A, readAuthFixtureEnv } from './fixtures/authFixture';
+import { gotoHome } from './support';
+
+// A parent edits their own name and their child's name in Preferences, and a car seats at most 6.
+// The first describe runs on the in-memory demo week, the other two only against the local Supabase stack
+// (README "Running the invite-link e2e").
+const fixture = readAuthFixtureEnv();
+
+async function openPreferences(page: Page): Promise<void> {
+  await page.getByTestId('open-preferences').click();
+  await expect(page.getByTestId('preferences')).toBeVisible();
+}
+
+test.describe('names and seats in Preferences', { tag: '@pending' }, () => {
+  test.beforeEach(async ({ page }) => {
+    await gotoHome(page);
+    await openPreferences(page);
+  });
+
+  test('seats go from 3 to 6, and 6 is the largest choice', async ({ page }) => {
+    for (const seats of ['3', '4', '5', '6']) await expect(page.getByTestId(`seats-${seats}`)).toBeVisible();
+    await expect(page.locator('[data-testid^="seats-"]')).toHaveCount(4);
+    await expect(page.getByTestId('seats-6+')).toHaveCount(0);
+  });
+
+  test('choosing 6 seats is saved', async ({ page }) => {
+    await page.getByTestId('seats-6').click();
+    await page.getByTestId('preferences-save').click();
+    await expect(page.getByTestId('week-grid')).toBeVisible();
+    await openPreferences(page);
+    await expect(page.getByTestId('seats-6')).toHaveAttribute('aria-pressed', 'true');
+  });
+
+  test('shows my name and my child’s name, ready to edit', async ({ page }) => {
+    await page.getByTestId('back').click();
+    const greeting = await page.getByTestId('header-greeting').innerText();
+    await openPreferences(page);
+    const parentName = await page.getByTestId('names-parent').inputValue();
+    expect(parentName.length).toBeGreaterThan(0);
+    expect(greeting).toContain(parentName);
+    expect((await page.getByTestId('names-child').inputValue()).length).toBeGreaterThan(0);
+    await expect(page.getByTestId('names-parent')).toHaveAttribute('maxlength', String(DISPLAY_NAME_MAX_LENGTH));
+    await expect(page.getByTestId('names-child')).toHaveAttribute('maxlength', String(DISPLAY_NAME_MAX_LENGTH));
+  });
+
+  test('editing my name and my child’s name updates the header', async ({ page }) => {
+    await page.getByTestId('names-parent').fill('שם');
+    await page.getByTestId('names-child').fill('שם');
+    await page.getByTestId('preferences-save').click();
+    await expect(page.getByTestId('week-grid')).toBeVisible();
+    await expect(page.getByTestId('header-greeting')).toContainText('שם');
+    await expect(page.getByTestId('header-subtitle')).toContainText('שם');
+  });
+
+  test('an empty name is refused in place and nothing is saved', async ({ page }) => {
+    const before = await page.getByTestId('names-parent').inputValue();
+    await page.getByTestId('names-parent').fill('   ');
+    await page.getByTestId('preferences-save').click();
+    await expect(page.getByTestId('names-error')).toBeVisible();
+    expect(await page.getByTestId('names-error').innerText()).not.toMatch(/[A-Za-z]/);
+    await expect(page.getByTestId('preferences')).toBeVisible();
+
+    await page.getByTestId('back').click();
+    await expect(page.getByTestId('header-greeting')).toContainText(before);
+  });
+});
+
+/** One fresh family per project, so renaming never touches a name another spec relies on. */
+const FAMILY_BY_PROJECT: Record<string, { parent: string; child: string; newParent: string; newChild: string }> = {
+  mobile: { parent: 'שם', child: 'שם', newParent: 'שם', newChild: 'שם' },
+  desktop: { parent: 'שם', child: 'שם', newParent: 'שם', newChild: 'שם' },
+};
+
+interface Family {
+  childId: string;
+  parentId: string;
+  names: { parent: string; child: string; newParent: string; newChild: string };
+}
+
+async function addFamily(device: SupabaseClient, projectName: string, suffix = ''): Promise<Family> {
+  const base = FAMILY_BY_PROJECT[projectName];
+  if (!base) throw new Error(`no family for project ${projectName}`);
+  const names = { ...base, parent: `${base.parent}${suffix}`, child: `${base.child}${suffix}` };
+  const joined = await device.rpc('join_group', { p_token: GROUP_A.token, p_display_name: names.parent, p_child_name: names.child, p_area: FIXTURE_AREAS[0] });
+  expect(joined.error).toBeNull();
+  const [row] = joined.data as Array<{ child_id: string; parent_id: string }>;
+  if (!row) throw new Error('join_group returned no row');
+  return { childId: row.child_id, parentId: row.parent_id, names };
+}
+
+function childButton(page: Page, childId: string): Locator {
+  return page.locator(`[data-testid="pick-child"][data-child-id="${childId}"]`);
+}
+
+async function enterAs(page: Page, family: Family): Promise<void> {
+  await page.goto(`/join/${GROUP_A.token}`);
+  await childButton(page, family.childId).click();
+  await expect(page.getByTestId('week-grid')).toBeVisible();
+}
+
+test.describe('names on the real database', { tag: '@pending' }, () => {
+  test.skip(!fixture, 'needs the E2E_SUPABASE_* variables and a local stack with anonymous sign-ins');
+
+  test('renamed names are saved, survive a reload, and the family’s other phone shows them', async ({ page, browser }, testInfo) => {
+    if (!fixture) return;
+    const family = await addFamily(await anonymousDevice(fixture), testInfo.project.name);
+    await enterAs(page, family);
+
+    await openPreferences(page);
+    await page.getByTestId('names-parent').fill(family.names.newParent);
+    await page.getByTestId('names-child').fill(family.names.newChild);
+    await page.getByTestId('preferences-save').click();
+    await expect(page.getByTestId('week-grid')).toBeVisible();
+
+    await page.reload();
+    await expect(page.getByTestId('header-greeting')).toContainText(family.names.newParent);
+    await expect(page.getByTestId('header-subtitle')).toContainText(family.names.newChild);
+
+    const otherDevice = await browser.newContext();
+    try {
+      const otherPage = await otherDevice.newPage();
+      await otherPage.goto(`/join/${GROUP_A.token}`);
+      await expect(childButton(otherPage, family.childId)).toContainText(family.names.newChild);
+      await childButton(otherPage, family.childId).click();
+      await expect(otherPage.getByTestId('header-greeting')).toContainText(family.names.newParent);
+      await expect(otherPage.getByTestId('header-subtitle')).toContainText(family.names.newChild);
+    } finally {
+      await otherDevice.close();
+    }
+  });
+
+  test('a failed rename stays in Preferences with an in-place error', async ({ page }, testInfo) => {
+    if (!fixture) return;
+    const family = await addFamily(await anonymousDevice(fixture), testInfo.project.name, 'שם');
+    await enterAs(page, family);
+    await page.route('**/rest/v1/children*', (route) =>
+      route.request().method() === 'PATCH'
+        ? route.fulfill({ status: 500, contentType: 'application/json', body: JSON.stringify({ message: 'simulated outage' }) })
+        : route.continue(),
+    );
+    await openPreferences(page);
+    await page.getByTestId('names-child').fill(family.names.newChild);
+    await page.getByTestId('preferences-save').click();
+    await expect(page.getByTestId('preferences-save-error')).toBeVisible();
+    await expect(page.getByTestId('preferences')).toBeVisible();
+  });
+});
+
+test.describe('names and seats: the API refuses what the screen never offers', { tag: '@pending' }, () => {
+  test.skip(!fixture, 'needs the E2E_SUPABASE_* variables and a local stack with anonymous sign-ins');
+
+  test('a parent renames only their own family’s child, within the name length', async () => {
+    if (!fixture) return;
+    const device = await anonymousDevice(fixture);
+    const family = await addFamily(device, test.info().project.name, 'שם');
+
+    const otherFamily = await device.from('children').update({ display_name: 'שם' }).eq('id', CHILD_E.id).select('id');
+    expect(otherFamily.data ?? []).toEqual([]);
+    const tooLong = await device.from('children').update({ display_name: 'שם'.repeat(DISPLAY_NAME_MAX_LENGTH + 1) }).eq('id', family.childId);
+    expect(tooLong.error).not.toBeNull();
+    const movedGroup = await device.from('children').update({ group_id: GROUP_A.id }).eq('id', family.childId);
+    expect(movedGroup.error).not.toBeNull();
+
+    const own = await device.from('children').update({ display_name: family.names.newChild }).eq('id', family.childId).select('id');
+    expect(own.data).toEqual([{ id: family.childId }]);
+  });
+
+  test('a car cannot be saved with more than 6 seats', async () => {
+    if (!fixture) return;
+    const device = await anonymousDevice(fixture);
+    const family = await addFamily(device, test.info().project.name, 'שם');
+    const seven = await device
+      .from('driving_preferences')
+      .upsert({ parent_id: family.parentId, group_id: GROUP_A.id, max_drives_per_week: 2, seats: 7 }, { onConflict: 'parent_id' });
+    expect(seven.error).not.toBeNull();
+    const six = await device
+      .from('driving_preferences')
+      .upsert({ parent_id: family.parentId, group_id: GROUP_A.id, max_drives_per_week: 2, seats: 6 }, { onConflict: 'parent_id' });
+    expect(six.error).toBeNull();
+  });
+});
