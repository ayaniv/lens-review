@@ -0,0 +1,85 @@
+import { expect, test, type Browser, type Locator, type Page } from '@playwright/test';
+import { anonymousDevice, CHILD_C, FIXTURE_AREAS, GROUP_A, readAuthFixtureEnv } from './fixtures/authFixture';
+import { expectNoLatinText } from './support';
+
+// Both parents of a child share one family: each child is listed once as "שם שם <child>", and any phone that taps
+// it acts for that family. The second parent's phone adds no child and no family. Runs only against the local
+// Supabase stack (README "Running the invite-link e2e").
+const fixture = readAuthFixtureEnv();
+
+/** One fresh family per project, created through the API as the first phone would: both projects run at once. */
+const FAMILY_BY_PROJECT: Record<string, { parent: string; child: string }> = {
+  mobile: { parent: 'שם', child: 'שם' },
+  desktop: { parent: 'שם', child: 'שם' },
+};
+
+function childButton(page: Page, childId: string): Locator {
+  return page.locator(`[data-testid="pick-child"][data-child-id="${childId}"]`);
+}
+
+async function enterAs(page: Page, childId: string): Promise<void> {
+  await page.goto(`/join/${GROUP_A.token}`);
+  await expect(page.getByTestId('pick-child-screen')).toBeVisible();
+  await childButton(page, childId).click();
+  await expect(page.getByTestId('week-grid')).toBeVisible();
+}
+
+async function withPhone(browser: Browser, run: (page: Page) => Promise<void>): Promise<void> {
+  const phone = await browser.newContext();
+  try {
+    await run(await phone.newPage());
+  } finally {
+    await phone.close();
+  }
+}
+
+test.describe('second parent', { tag: '@pending' }, () => {
+  test.skip(!fixture, 'needs the E2E_SUPABASE_* variables and a local stack with anonymous sign-ins');
+
+  test('each child is listed once as “parent of <child>”, with no parent name, and one tap opens the family’s week', async ({ page }) => {
+    await page.goto(`/join/${GROUP_A.token}`);
+    await expect(childButton(page, CHILD_C.id)).toHaveCount(1);
+    await expect(childButton(page, CHILD_C.id)).toContainText(CHILD_C.name);
+    await expect(childButton(page, CHILD_C.id)).not.toContainText(CHILD_C.parent.name);
+    await expectNoLatinText(page);
+
+    await childButton(page, CHILD_C.id).click();
+    await expect(page.getByTestId('week-grid')).toBeVisible();
+    await expect(page.getByTestId('header-subtitle')).toContainText(CHILD_C.name);
+  });
+
+  test('the second parent’s phone acts for the same family: an absence marked on one phone shows on the other', async ({ page, browser }) => {
+    if (!fixture) return;
+    const names = FAMILY_BY_PROJECT[test.info().project.name];
+    if (!names) throw new Error(`no family for project ${test.info().project.name}`);
+    const joined = await (await anonymousDevice(fixture)).rpc('join_group', {
+      p_token: GROUP_A.token,
+      p_display_name: names.parent,
+      p_child_name: names.child,
+      p_area: FIXTURE_AREAS[0],
+    });
+    expect(joined.error).toBeNull();
+    const [family] = joined.data as Array<{ child_id: string }>;
+    if (!family) throw new Error('join_group returned no row');
+
+    await enterAs(page, family.child_id);
+    const attendance = page.locator('[data-testid^="attendance-switch-"]').first();
+    await expect(attendance).toHaveAttribute('aria-checked', 'true');
+    const switchTestId = await attendance.getAttribute('data-testid');
+    if (!switchTestId) throw new Error('attendance switch has no test id');
+    await attendance.click();
+    await expect(attendance).toHaveAttribute('aria-checked', 'false');
+
+    await withPhone(browser, async (secondPhone) => {
+      await enterAs(secondPhone, family.child_id);
+      await expect(secondPhone.getByTestId('header-subtitle')).toContainText(names.child);
+      await expect(secondPhone.getByTestId(switchTestId)).toHaveAttribute('aria-checked', 'false');
+    });
+
+    // Two phones, still one child on the list.
+    await withPhone(browser, async (thirdPhone) => {
